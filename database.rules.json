{
  "rules": {
    ".read": true,
    "events": {
      "$eventId": {
        "sessions": {
          ".write": true,
          "$sessionId": {
            ".validate": "newData.hasChildren(['title', 'order', 'status', 'day', 'type'])"
          }
        },
        "currentSessionId": { ".write": true },
        "timer": {
          ".write": true,
          ".validate": "newData.hasChildren(['running', 'baseSeconds'])"
        },
        "message": {
          ".write": true,
          ".validate": "newData.hasChildren(['active', 'text'])"
        },
        "timerMode":  { ".write": true },
        "delayMins":  { ".write": true }
      }
    },
    "briefing":        { ".write": true },
    "checklist":       { ".write": true }
  }
}
